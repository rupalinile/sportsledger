NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

DB_HOST=localhost
DB_PORT=3306
DB_USER=cricktrack_user
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=cricktrack
DB_CONNECTION_LIMIT=10

# Browser/WebView origins that may read API responses.
# Native Android/iOS and most native desktop HTTP clients do not send a browser Origin header.
# Production must use explicit origins; do not use * in production.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,app://cricktrack,tauri://localhost
CORS_ALLOW_NO_ORIGIN=true
CORS_CREDENTIALS=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1500

JWT_ACCESS_SECRET=replace-with-a-strong-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-token-secret
JWT_PASSWORD_RESET_SECRET=replace-with-a-strong-password-reset-token-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_PASSWORD_RESET_EXPIRES_IN=10m

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_NAME=CrickTrack
SMTP_FROM_EMAIL=no-reply@cricktrack.example.com

PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_RESENDS=3
OTP_HMAC_SECRET=replace-with-a-strong-otp-hmac-secret-at-least-32-chars
